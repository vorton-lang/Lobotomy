{
  "name": "lobotomy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "cargo build -p lobotomyd -p lobotomy-worker --manifest-path ../backend/Cargo.toml && vite build && electron .",
    "dev": "vite",
    "build": "vite build",
    "icons:generate": "node scripts/icons.mjs",
    "api:generate": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "typecheck": "npm run typecheck:app && npm run typecheck:node && npm run typecheck:tests",
    "test": "vitest run",
    "e2e": "playwright test",
    "app": "vite build && electron .",
    "app:dev": "electron . --dev",
    "bench": "cargo build --release -p lobotomyd --manifest-path ../backend/Cargo.toml && vite build && playwright test -c bench/bench.config.ts",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "typecheck:app": "tsc -p tsconfig.json",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "lucide-react": "^1.55.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remend": "^1.4.0",
    "shiki": "^4.5.0",
    "virtua": "^0.52.10",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
